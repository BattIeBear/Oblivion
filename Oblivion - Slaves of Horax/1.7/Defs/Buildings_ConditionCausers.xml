<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<!-- ========================= BASE ========================= -->
	<ThingDef Name="ConditionCauserBase_Ritual" Abstract="True" ParentName="ConditionCauserBase">
		<altitudeLayer>FloorEmplacement</altitudeLayer>
		<passability>Standable</passability>
		<blockWind>false</blockWind>
		<pathCost Inherit="False" />
		<fillPercent Inherit="False" />
		<statBases Inherit="False">
			<Flammability>0</Flammability>
		</statBases>
		<useHitPoints>false</useHitPoints>
		<noRightClickDraftAttack>true</noRightClickDraftAttack>
		<building>
			<buildingTags Inherit="False" />
			<claimable>false</claimable>
			<deconstructible>false</deconstructible>
			<destroySound Inherit="False" />
		</building>
		<comps Inherit="False" />
		<size>(1, 1)</size>
		<graphicData>
			<texPath>Things/Building/HoraxRitualSpot_Blank</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(1, 1)</drawSize>
		</graphicData>
		<receivesSignals>true</receivesSignals>
		<castEdgeShadows>false</castEdgeShadows>
		<tickerType>Normal</tickerType>
		<rotatable>false</rotatable>
		<selectable>false</selectable>
		<terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
		<soundImpactDefault Inherit="False" />
		<isMechClusterThreat>false</isMechClusterThreat>
		<killedLeavings Inherit="False" />
	</ThingDef>

	<SitePartDef Name="ConditionCauserSitePartBase_Ritual" Abstract="True" ParentName="ConditionCauserSitePartBase">
		<workerClass>SitePartWorker_ConditionCauser</workerClass>
		<siteTexture>World/WorldObjects/Sites/Outpost</siteTexture>
		<applyFactionColorToSiteTexture>true</applyFactionColorToSiteTexture>
		<expandingIconTexture>World/WorldObjects/Expanding/Sites/RitualSite</expandingIconTexture>
		<wantsThreatPoints>true</wantsThreatPoints>
		<badEvenIfNoMap>true</badEvenIfNoMap>
		<gravShipsCanLandOn>true</gravShipsCanLandOn>
		<tags Inherit ="False">
			<li>QuestActiveThreat</li>
			<li>BattIeBear_QuestRitualCauser</li>
		</tags>
	</SitePartDef>

	<GenStepDef Name="ConditionCauserGenStepBase_Ritual" Abstract="True" ParentName="ConditionCauserGenStepBase">
		<order>490</order>
		<genStep Class="Oblivion_SlavesOfHorax.GenStep_ConditionCauser_Ritual">
			<nearMapCenter>true</nearMapCenter>
		</genStep>
	</GenStepDef>

	<!-- ========================= Sun fracture ========================= -->
	<ThingDef ParentName="ConditionCauserBase_Ritual">
		<defName>BattIeBear_SunFractureRitual</defName>
		<label>sun fracture ritual</label>
		<description>A powerful ritual which summons swarms of mechanites which blot out the sun.</description>
		<comps>
			<li Class="Oblivion_SlavesOfHorax.CompProperties_CausesGameCondition_Ritual">
				<conditionDef>BattIeBear_SunFractureRitual</conditionDef>
				<worldRange>9</worldRange>
			</li>
		</comps>
	</ThingDef>

	<GameConditionDef>
		<defName>BattIeBear_SunFractureRitual</defName>
		<conditionClass>Oblivion_SlavesOfHorax.GameCondition_NoSunlight_Fractured</conditionClass>
		<label>sun fracture ritual</label>
		<description>A nearby ritual has plunged the landscape into darkness.</description>
		<letterText>A ritual has plunged the landscape into darkness.</letterText>
		<letterDef>NegativeEvent</letterDef>
		<canBePermanent>true</canBePermanent>
		<natural>false</natural>
	</GameConditionDef>
	
	<SitePartDef ParentName="ConditionCauserSitePartBase_Ritual">
		<defName>BattIeBear_SunFractureRitual</defName>
		<label>sun fracture ritual</label>
		<description>They are summoning swarms of mechanites which blot out the sun.</description>
		<workerClass>Oblivion_SlavesOfHorax.SitePartWorker_ConditionCauser_Ritual_SunFracture</workerClass>
		<conditionCauserDef>BattIeBear_SunFractureRitual</conditionCauserDef>
		<excludesTags>
			<li>Electrical</li>
		</excludesTags>
	</SitePartDef>

	<GenStepDef ParentName="ConditionCauserGenStepBase_Ritual">
		<defName>BattIeBear_SunFractureRitual</defName>
		<linkWithSite>BattIeBear_SunFractureRitual</linkWithSite>
	</GenStepDef>

	<!-- ========================= Mind fracture ========================= -->
	<ThingDef ParentName="ConditionCauserBase_Ritual">
		<defName>BattIeBear_MindFractureRitual</defName>
		<label>mind fracture ritual</label>
		<description>A powerful ritual which sends a psychic drone through an orbital amplifier, affecting a whole region of the planet and driving everyone towards insanity. The effect is modulated by an individual's psychic sensitivity.</description>
		<comps>
			<li Class="Oblivion_SlavesOfHorax.CompProperties_CausesGameCondition_Ritual">
				<conditionDef>BattIeBear_MindFractureRitual</conditionDef>
				<worldRange>9</worldRange>
			</li>
		</comps>
	</ThingDef>

	<GameConditionDef>
		<defName>BattIeBear_MindFractureRitual</defName>
		<conditionClass>Oblivion_SlavesOfHorax.GameCondition_PsychicEmanation_Ritual</conditionClass>
		<label>mind fracture ritual</label>
		<description>A nearby ritual is driving everyone nearby towards insanity!</description>
		<letterText>A ritual is driving everyone towards insanity!</letterText>
		<letterDef>NegativeEvent</letterDef>
		<canBePermanent>true</canBePermanent>
		<natural>false</natural>
	</GameConditionDef>

	<SitePartDef ParentName="ConditionCauserSitePartBase_Ritual">
		<defName>BattIeBear_MindFractureRitual</defName>
		<label>mind fracture ritual</label>
		<description>They are sending a psychic drone through an orbital amplifier, affecting a whole region of the planet and driving everyone towards insanity. The effect is modulated by an individual's psychic sensitivity.</description>
		<workerClass>Oblivion_SlavesOfHorax.SitePartWorker_ConditionCauser_Ritual_MindFracture</workerClass>
		<conditionCauserDef>BattIeBear_MindFractureRitual</conditionCauserDef>
		<excludesTags>
			<li>Electrical</li>
		</excludesTags>
	</SitePartDef>

	<GenStepDef ParentName="ConditionCauserGenStepBase_Ritual">
		<defName>BattIeBear_MindFractureRitual</defName>
		<linkWithSite>BattIeBear_MindFractureRitual</linkWithSite>
	</GenStepDef>

