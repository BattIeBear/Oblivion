<?xml version="1.0" encoding="utf-8" ?>
<Patch>

	<!-- Blessed by Horax-->
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Blessed by Horax</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>
				<!-- Removes generic disperser to give greater control -->
				<li Class="PatchOperationRemove">
					<xpath>Defs/PawnKindDef[@Name="HoraxianBase"]/startingHediffs/li[def="CultBuff"]</xpath>
				</li>
				<!-- Adjusts Darkness Blessings's color -->
				<li Class="PatchOperationReplace">
					<xpath>Defs/HediffDef[defName="CultBuffs_DarknessBuff"]/comps/li[@Class="CultBuffs.HediffCompProperties_SetupPawnKind"]/skinColorOverride</xpath>
					<value>
						<skinColorOverride>(60, 60, 60)</skinColorOverride>
					</value>
				</li>
				<!-- Adds a chance for Underthralls to spawn with a Flesh Blessing -->
				<li Class="PatchOperationAdd">
					<xpath>Defs/PawnKindDef[defName="Horaxian_Underthrall"]/startingHediffs</xpath>
					<value>
						<li>
							<def>CultBuffs_FleshBuff</def>
							<chance>0.15</chance>
						</li>
					</value>
				</li>
				<!-- Adds a chance for Highthralls to spawn with a Metal Blessing -->
				<li Class="PatchOperationAdd">
					<xpath>Defs/PawnKindDef[defName="Horaxian_Highthrall" or defName="BattIeBear_Horaxian_MeleeHighthrall"]/startingHediffs</xpath>
					<value>
						<li>
							<def>CultBuffs_MetalBuff</def>
							<chance>0.10</chance>
						</li>
					</value>
				</li>
				<!-- Adds a chance for Orators and Mouths of Oblivion to spawn with a Darkness Blessing -->
				<li Class="PatchOperationAdd">
					<xpath>Defs/PawnKindDef[defName="BattIeBear_Horaxian_Orator" or defName="BattIeBear_Horaxian_MouthOfOblivion"]/startingHediffs</xpath>
					<value>
						<li>
							<def>CultBuffs_DarknessBuff</def>
							<chance>0.10</chance>
						</li>
					</value>
				</li>
			</operations>
		</match>
	</Operation>
	
</Patch>